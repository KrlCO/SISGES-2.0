@page "/mantenimientos/contometros"
@using Sisges.Domain.Common.Interfaces
@using Sisges.Domain.Entities
@inject IContometroMecanicoRepository ContometroRepository
@inject IAdminDocumentosRepository AdminDocumentosRepository
@inject IGrifoContext GrifoContext
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Contómetros Mecánicos - SISGES</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div class="min-w-0">
        <h4 class="fw-bold mb-0 text-body-emphasis">
            <i class="bi bi-speedometer text-primary me-2"></i>Contómetros Mecánicos
        </h4>
        <small class="text-body-secondary">Mantenimientos · reemplaza a <code>frmContometroMeca</code> · @GrifoContext.GrifoActivoId</small>
    </div>
    @if (ultimo is not null)
    {
        <span class="badge bg-body-tertiary text-body-secondary fs-6 fw-normal">
            Último registrado: <strong class="text-body-emphasis">@ultimo.FechaTurno.ToString("dd/MM/yyyy") · turno @ultimo.Turno</strong>
        </span>
    }
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill fs-5 me-2"></i><div>@mensajeExito</div>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger d-flex align-items-start" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i><div class="text-break">@mensajeError</div>
    </div>
}

@* ═══════════════ CONSULTA Y ACCIONES ═══════════════ *@
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-6 col-md-3 col-xl-2">
                <label for="fecha" class="form-label small fw-semibold">Fecha turno</label>
                <input id="fecha" type="date" class="form-control form-control-sm" @bind="fechaConsulta" disabled="@EnEdicion" />
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label for="turno" class="form-label small fw-semibold">Turno</label>
                <select id="turno" class="form-select form-select-sm" @bind="turnoConsulta" disabled="@EnEdicion">
                    @foreach (var t in turnos)
                    {
                        <option value="@t.Codigo">@t.Codigo - @t.Descripcion</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-auto">
                <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="ConsultarAsync" disabled="@(EnEdicion || cargando)">
                    <i class="bi bi-search me-1"></i>Consultar
                </button>
            </div>

            <div class="col-12 col-md d-flex flex-wrap gap-2 justify-content-md-end">
                @if (!EnEdicion)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NuevoAsync" disabled="@cargando">
                        <i class="bi bi-plus-lg me-1"></i>Nuevo · @siguiente.Fecha.ToString("dd/MM/yyyy") turno @siguiente.Turno
                    </button>
                    @if (EsUltimo)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Modificar">
                            <i class="bi bi-pencil me-1"></i>Modificar
                        </button>
                        <button type="button" class="btn @(confirmandoEliminar ? "btn-danger" : "btn-outline-danger") btn-sm" @onclick="EliminarAsync" disabled="@guardando">
                            <i class="bi bi-trash me-1"></i>@(confirmandoEliminar ? "Sí, eliminar" : "Eliminar")
                        </button>
                    }
                }
                else
                {
                    <div class="form-check form-switch align-self-center me-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="cambio-precio" @bind="cambioPrecio" />
                        <label class="form-check-label small" for="cambio-precio">Cambio de precio</label>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopiarInicialesSinVenta" disabled="@guardando"
                            title="Pone la lectura inicial como final en las mangueras que no tienen lectura final">
                        <i class="bi bi-arrow-right-square me-1"></i>Sin venta = inicial
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicionAsync" disabled="@guardando">Cancelar</button>
                    <button type="button" class="btn @(confirmandoGuardar ? "btn-warning" : "btn-success") btn-sm px-3" @onclick="GuardarAsync" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span><span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i><span>@(confirmandoGuardar ? "Sí, guardar" : "Guardar")</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@if (EnEdicion && avisoTurnoAbierto)
{
    <div class="alert alert-warning small" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>El turno @fechaEdicion.ToString("dd/MM/yyyy") · @turnoEdicion todavía está abierto.
        Las lecturas finales se toman al cerrar el turno.
    </div>
}
@if (errores.Count > 0)
{
    <div class="alert alert-danger small" role="alert">
        @foreach (var e in errores.Take(12))
        {
            <div>@e</div>
        }
        @if (errores.Count > 12)
        {
            <div>... y @(errores.Count - 12) más.</div>
        }
    </div>
}

@if (cargando)
{
    <div class="text-center text-body-secondary py-5">
        <span class="spinner-border spinner-border-sm me-2" role="status"></span>Cargando contómetros...
    </div>
}
else if (filas.Count == 0)
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5 text-body-secondary">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>No existe información para mostrar.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header py-3 border-bottom">
            <h6 class="mb-0 fw-bold text-body-emphasis">
                @TituloGrilla
            </h6>
        </div>
        <div class="table-responsive reporte-scroll">
            <table class="table table-sm align-middle mb-0 text-nowrap">
                <thead class="table-head-themed">
                    <tr>
                        <th class="text-center">Lado</th>
                        <th class="text-center">Mang.</th>
                        <th>Producto</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Vol. inicial</th>
                        <th class="text-end">Vol. final</th>
                        <th class="text-end">Calibración</th>
                        <th class="text-end">Galones</th>
                        <th class="text-end">Total venta</th>
                        <th>Grifero</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in filas)
                    {
                        <tr class="@(f.Galones < 0 ? "table-danger" : null)">
                            <td class="text-center">@f.Lado</td>
                            <td class="text-center">@f.Manguera</td>
                            <td>@f.Producto</td>
                            <td class="text-end" style="min-width: 6rem">
                                @if (EnEdicion && cambioPrecio)
                                {
                                    <input type="number" class="form-control form-control-sm text-end font-monospace" min="0" step="0.01"
                                           data-solo="decimal" @bind="f.Precio" @bind:event="oninput" />
                                }
                                else
                                {
                                    <span class="font-monospace">@f.Precio.ToString("N2")</span>
                                }
                            </td>
                            <td class="text-end font-monospace">@f.Inicial.ToString("N3")</td>
                            <td class="text-end" style="min-width: 9rem">
                                @if (EnEdicion)
                                {
                                    <input type="number" class="form-control form-control-sm text-end font-monospace" min="0" step="0.001"
                                           data-solo="decimal" @bind="f.Final" @bind:event="oninput" />
                                }
                                else
                                {
                                    <span class="font-monospace">@f.Final?.ToString("N3")</span>
                                }
                            </td>
                            <td class="text-end" style="min-width: 7rem">
                                @if (EnEdicion)
                                {
                                    <input type="number" class="form-control form-control-sm text-end font-monospace" min="0" step="0.001"
                                           data-solo="decimal" @bind="f.Calibracion" @bind:event="oninput" />
                                }
                                else
                                {
                                    <span class="font-monospace">@f.Calibracion?.ToString("N3")</span>
                                }
                            </td>
                            <td class="text-end font-monospace">@f.Galones.ToString("N3")</td>
                            <td class="text-end font-monospace fw-semibold">@f.Importe.ToString("N2")</td>
                            <td style="min-width: 13rem">
                                @if (EnEdicion)
                                {
                                    <select class="form-select form-select-sm" @bind="f.Grifero">
                                        <option value="0">Seleccionar...</option>
                                        @foreach (var g in griferos)
                                        {
                                            <option value="@g.Codigo">@g.Descripcion</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <span class="small">@f.NombreGrifero</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ═══════════════ RESUMEN POR PRODUCTO ═══════════════ *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header py-3 border-bottom">
            <h6 class="mb-0 fw-bold text-body-emphasis"><i class="bi bi-calculator text-primary me-2"></i>Resumen</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-head-themed">
                    <tr><th>Producto</th><th class="text-end">Galones</th><th class="text-end">Importe</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Resumen)
                    {
                        <tr>
                            <td>@r.Producto</td>
                            <td class="text-end font-monospace">@r.Galones.ToString("N3")</td>
                            <td class="text-end font-monospace">@r.Importe.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="fila-total">
                        <td>TOTAL</td>
                        <td class="text-end font-monospace">@filas.Sum(f => f.Galones).ToString("N3")</td>
                        <td class="text-end font-monospace">@TotalImporte.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
